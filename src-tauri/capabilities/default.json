{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for ZSpace Memo main and floating windows",
  "windows": ["main", "floating"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "opener:default",
    "autostart:default",
    "global-shortcut:default"
  ]
}
