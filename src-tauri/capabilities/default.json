{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for ZSpace Kit main, floating, and sticky windows",
  "windows": ["main", "floating", "sticky-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "opener:default",
    "autostart:default",
    "global-shortcut:default"
  ]
}
