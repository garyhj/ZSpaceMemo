{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZSpace Memo",
  "version": "0.1.0",
  "identifier": "com.garyhj.zspacememo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZSpace Memo",
        "width": 1160,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "floating",
        "title": "ZSpace Memo 快捷",
        "url": "/?mode=floating",
        "width": 350,
        "height": 520,
        "minWidth": 300,
        "minHeight": 360,
        "visible": false,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/zspace-cli"
    ]
  }
}
